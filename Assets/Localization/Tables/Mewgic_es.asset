      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934374
    m_Localized: Completa {0:plural:{} botella|{} botellas} en niveles ganados
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934375
    m_Localized: Gana {0:plural:{} nivel|{} niveles}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934376
    m_Localized: Consigue {0:plural:{} estrella|{} estrellas} en niveles ganados
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934377
    m_Localized: Usa {0:plural:{} potenciador|{} potenciadores}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934378
    m_Localized: Las recompensas otorgan usos reales de potenciadores.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934379
    m_Localized: RECLAMAR REGALO
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934380
    m_Localized: +{0} pista
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934381
    m_Localized: 100 monedas y 1 pista guardadas.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934382
    m_Localized: No se pudo reclamar el regalo. Revisa la fecha y tu partida.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934383
    m_Localized: "\xA1Recompensa de misi\xF3n guardada!"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934384
    m_Localized: "\xA1El regalo del d\xEDa est\xE1 listo!"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934385
    m_Localized: Ya recibiste el regalo de hoy.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934386
    m_Localized: "Disponible 24 horas despu\xE9s de tu \xFAltima recompensa."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 3185934387
    m_Localized: "Se renueva en {0}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
