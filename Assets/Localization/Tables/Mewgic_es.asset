    m_Localized: Saldo {0} monedas
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 1443505006542853
    m_Localized: "Necesitas m\xE1s monedas."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 1443505006542854
    m_Localized: Comprado. En reserva {0}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 1443505006542855
    m_Localized: "Pr\xF3ximo cofre en {0} min"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 1445448714125312
    m_Localized: "M\xFAsica"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 1445448823177216
    m_Localized: Efectos de sonido
    m_Metadata:
      m_Items:
      - rid: 1668092879795126367
  - m_Id: 1445448823177217
    m_Localized: "Vibraci\xF3n"
    m_Metadata:
