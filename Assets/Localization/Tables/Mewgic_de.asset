    m_Localized: Insgesamt <color=#FFE06A>{0} Gold</color>
    m_Metadata:
      m_Items:
      - rid: 1668092879795126366
  - m_Id: 2913532691972098
    m_Localized: "Werbung gerade nicht verf\xFCgbar"
    m_Metadata:
      m_Items: []
  - m_Id: 2913532691972099
    m_Localized: Schau die Werbung bis zum Ende
    m_Metadata:
      m_Items: []
