    m_Metadata:
      m_Items:
      - rid: 1668092879795126366
  - m_Id: 3190128682
    m_Localized: "Level {0} ist gesperrt. Schlie\xDFe zuerst das vorherige Level
      ab."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126366
  - m_Id: 3190128683
    m_Localized: Die Truhenbelohnung wurde bereits abgeholt.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126366
  - m_Id: 3190128684
    m_Localized: "{0}\nSchlie\xDFe alle 50 Insellevel ab, um die Truhe zu \xF6ffnen."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126366
  - m_Id: 3190128685
    m_Localized: 'Deine Truhe ist bereit!

      Belohnung: +{0} Tipp'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126366
  - m_Id: 3190128686
    m_Localized: "Truhe ge\xF6ffnet! Tipp gespeichert."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126366
  - m_Id: 3190128687
    m_Localized: "Level wird vorbereitet\u2026"
