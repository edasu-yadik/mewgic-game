  - m_Id: 3181740044
    m_Localized: Carte
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740045
    m_Localized: "\xC9v\xE9nements"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740046
    m_Localized: "\xC9quipe"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740047
    m_Localized: Inventaire
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740048
    m_Localized: "La boutique de pi\xE8ces est ferm\xE9e. Aucun achat n\u2019est
      effectu\xE9."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740049
    m_Localized: "La boutique de gemmes est ferm\xE9e. Aucun achat n\u2019est effectu\xE9."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740050
    m_Localized: "La recharge d\u2019\xE9nergie n\u2019est pas disponible. Ton \xE9nergie
      est inchang\xE9e."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740051
    m_Localized: "L\u2019inventaire n\u2019est pas encore disponible."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740052
    m_Localized: "Les \xE9quipes ne sont pas encore disponibles."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740053
    m_Localized: "PARAM\xC8TRES"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740054
    m_Localized: Langue
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740055
    m_Localized: "SON : ACTIV\xC9"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740056
    m_Localized: "SON : COUP\xC9"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740057
    m_Localized: "Le son et la langue sont enregistr\xE9s sur cet appareil. Le contenu
      audio n\u2019est pas encore disponible."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740058
    m_Localized: "\xC9chec de l\u2019enregistrement. Tes donn\xE9es pr\xE9c\xE9dentes
      sont conserv\xE9es ; r\xE9essaie."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740059
    m_Localized: "Impossible de pr\xE9parer le niveau. Ta sauvegarde est conserv\xE9e
      ; r\xE9essaie."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740060
    m_Localized: "Ta sauvegarde n\u2019a pas pu \xEAtre lue et a \xE9t\xE9 conserv\xE9e.
      Relance l\u2019application."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740061
    m_Localized: "La date ou la sauvegarde n\u2019a pas pu \xEAtre v\xE9rifi\xE9e.
      Les r\xE9compenses sont indisponibles."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740062
    m_Localized: Niveau {0}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740063
    m_Localized: Coups {0}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740064
    m_Localized: "Niveau {0} \u2022 Coups : {1} \u2022 \xC9toiles : {2}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740065
    m_Localized: MAGIE ACCOMPLIE !
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740066
    m_Localized: NIVEAU SUIVANT
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3181740067
    m_Localized: REJOUER
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934336
    m_Localized: RECOMMENCER
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934337
    m_Localized: PAUSE
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934338
    m_Localized: REPRENDRE
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934339
    m_Localized: RECOMMENCER
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934340
    m_Localized: "DERNIER NIVEAU TERMIN\xC9"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934341
    m_Localized: "Premi\xE8re r\xE9ussite : +1 indice\nTa r\xE9compense est enregistr\xE9e."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934342
    m_Localized: "La r\xE9compense a d\xE9j\xE0 \xE9t\xE9 r\xE9cup\xE9r\xE9e.\nTon
      meilleur score en \xE9toiles est conserv\xE9."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934343
    m_Localized: Cette fiole est vide.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934344
    m_Localized: Ce coup est impossible.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934345
    m_Localized: "Bien jou\xE9 !"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934346
    m_Localized: Annuler
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934347
    m_Localized: Indice
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934348
    m_Localized: Fiole en plus
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934349
    m_Localized: "M\xE9langer"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934350
    m_Localized: "Le dernier coup a \xE9t\xE9 annul\xE9."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934351
    m_Localized: "Une fiole vide a \xE9t\xE9 ajout\xE9e."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934352
    m_Localized: "Les fioles ont \xE9t\xE9 r\xE9organis\xE9es."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934353
    m_Localized: "Plus d\u2019utilisations disponibles."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934354
    m_Localized: "Aucun coup \xE0 annuler."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934355
    m_Localized: "Aucun indice fiable trouv\xE9 ; ton utilisation est conserv\xE9e."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934356
    m_Localized: "Un indice est d\xE9j\xE0 affich\xE9 ; aucune utilisation d\xE9pens\xE9e."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934357
    m_Localized: Une seule fiole en plus par tentative.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934358
    m_Localized: "L\u2019agencement n\u2019a pas pu \xEAtre modifi\xE9 sans risque
      ; ton utilisation est conserv\xE9e."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934359
    m_Localized: "Regroupe les m\xEAmes couleurs.\nVerse dans une fiole vide ou assortie.\nTouche-moi
      pour de l\u2019aide !"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934360
    m_Localized: "Pr\xE9paration de ton voyage magique\u2026"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934361
    m_Localized: "Chargement de ton parcours\u2026"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934362
    m_Localized: "Pr\xE9paration des ressources magiques\u2026"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934363
    m_Localized: "Chargement du monde magique\u2026"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934364
    m_Localized: "Derni\xE8res touches de magie\u2026"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934365
    m_Localized: Bienvenue dans Mewgic !
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934366
    m_Localized: "R\xC9ESSAYER"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934367
    m_Localized: "Impossible de charger le monde. Ta sauvegarde est conserv\xE9e
      ; r\xE9essaie."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
