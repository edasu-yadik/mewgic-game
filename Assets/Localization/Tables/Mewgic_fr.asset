  - m_Id: 3185934374
    m_Localized: "Remplis {0:plural:{} fiole|{} fioles} dans les niveaux gagn\xE9s"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934375
    m_Localized: Gagne {0:plural:{} niveau|{} niveaux}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934376
    m_Localized: "Gagne {0:plural:{} \xE9toile|{} \xE9toiles} dans les niveaux gagn\xE9s"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934377
    m_Localized: Utilise {0:plural:{} bonus|{} bonus}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934378
    m_Localized: "Les r\xE9compenses donnent de vraies utilisations de bonus."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934379
    m_Localized: "R\xC9CUP\xC9RER"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934380
    m_Localized: +{0} indice
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934381
    m_Localized: "100 pi\xE8ces et 1 indice enregistr\xE9s."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934382
    m_Localized: "Cadeau non r\xE9cup\xE9r\xE9. V\xE9rifie la date et ta sauvegarde."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934383
    m_Localized: "R\xE9compense de mission enregistr\xE9e !"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934384
    m_Localized: "Le cadeau du jour est pr\xEAt !"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934385
    m_Localized: "Le cadeau du jour a \xE9t\xE9 r\xE9cup\xE9r\xE9."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934386
    m_Localized: "Disponible 24 heures apr\xE8s la derni\xE8re r\xE9compense."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3185934387
    m_Localized: "R\xE9initialisation \xE0 minuit local \u2022 {0:d}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128640
    m_Localized: Collection
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128641
    m_Localized: "\xC9V\xC9NEMENTS ET R\xC9COMPENSES"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128642
    m_Localized: "\xC9v\xE9nement\nhebdo"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128643
    m_Localized: 'Parcours

      de saison'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128644
    m_Localized: 'Missions

      du jour'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128645
    m_Localized: "R\xE9compenses\ncollection"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128646
    m_Localized: "\xC9v\xE9nement hebdomadaire\nSemaine des cascades de cristal"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128647
    m_Localized: "Gagne {0} niveaux\n+1 m\xE9lange + badge \xE9toile"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128648
    m_Localized: OUVRIR LE COFFRE
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128649
    m_Localized: "R\xE9compense enregistr\xE9e !"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128650
    m_Localized: "La r\xE9compense n\u2019est pas pr\xEAte ou a d\xE9j\xE0 \xE9t\xE9
      r\xE9cup\xE9r\xE9e."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128651
    m_Localized: "Parcours de saison \u2022 Gratuit"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128652
    m_Localized: +1 annulation
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128653
    m_Localized: '+1 fiole en plus

      + carte du chat'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128654
    m_Localized: "Premium \u2022 \xC0 venir"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128655
    m_Localized: Le contenu premium et les achats sont indisponibles. Aucun paiement
      ; seul le parcours gratuit est actif.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128656
    m_Localized: "Badge \xE9toile"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128657
    m_Localized: Carte du chat sorcier
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128658
    m_Localized: "Ta carte de collection. Visible dans la galerie ; ce n\u2019est
      pas un \xE9quipement."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128659
    m_Localized: "Gagne 3 niveaux en une semaine et r\xE9cup\xE8re le coffre hebdomadaire."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128660
    m_Localized: "R\xE9cup\xE8re la derni\xE8re r\xE9compense du parcours gratuit
      de saison."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128661
    m_Localized: "Les cartes gagn\xE9es restent dans ta collection."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128662
    m_Localized: "\xC9v\xE9nements hors ligne \u2022 Gagne des niveaux pour progresser."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128663
    m_Localized: "Termine les missions du jour.\nR\xE9compenses disponibles : {0}"
