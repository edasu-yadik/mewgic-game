    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128675
    m_Localized: "Niveaux {0}\u2013{1}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128676
    m_Localized: "VERROUILL\xC9 \u2022 {0}\u2013{1}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128677
    m_Localized: "{0} \u2022 Au-del\xE0 de la brume"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128678
    m_Localized: "{0}\nNouvelle \xEEle d\xE9bloqu\xE9e !"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128679
    m_Localized: "{0}\nNiveaux {1}\u2013{2}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128680
    m_Localized: "Choisis un niveau \u2022 Am\xE9liore tes \xE9toiles"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128681
    m_Localized: "RETOUR \xC0 LA CARTE"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128682
    m_Localized: "Le niveau {0} est verrouill\xE9. Termine d\u2019abord le pr\xE9c\xE9dent."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128683
    m_Localized: "La r\xE9compense de ce coffre a d\xE9j\xE0 \xE9t\xE9 r\xE9cup\xE9r\xE9e."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128684
    m_Localized: "{0}\nTermine les 50 niveaux de l\u2019\xEEle pour ouvrir le coffre."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128685
    m_Localized: "Ton coffre est pr\xEAt !\nR\xE9compense : +{0} indice"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128686
    m_Localized: "Coffre ouvert ! Indice enregistr\xE9."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128687
    m_Localized: "Pr\xE9paration du niveau\u2026"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128688
    m_Localized: Nouveaux Horizons {0}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128689
    m_Localized: "Village enchant\xE9"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128690
    m_Localized: Cascades de cristal
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128691
    m_Localized: Jardin lunaire
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128692
    m_Localized: "Ch\xE2teau c\xE9leste"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128693
    m_Localized: Bois des murmures
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128694
    m_Localized: "Mirage dor\xE9"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128695
    m_Localized: Royaume de corail
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128696
    m_Localized: Pics de givre lumineux
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128697
    m_Localized: "\xCEles m\xE9caniques"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128698
    m_Localized: "Bosquet \xE9toil\xE9"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128699
    m_Localized: "Biblioth\xE8que des arcanes"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 3190128700
    m_Localized: Citadelle des aurores
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 1662448402432
    m_Localized: '{0:0.#} M'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 1662528094208
    m_Localized: '{0:0.#} Md'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 1662528094209
    m_Localized: '{0:0.#}T'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 1662528094210
    m_Localized: '{0:0.#}Q'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 2225802149888
    m_Localized: MISSIONS DU JOUR
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 2973327785984
    m_Localized: Cadeau
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 1044860214018048
    m_Localized: "+{0} pi\xE8ces"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 1044860339847168
    m_Localized: "+{0} pi\xE8ces\nFin {1} + \xC9toiles {2}\nIndices +{3}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 1044860339847169
    m_Localized: "{0} pi\xE8ces + {1} indice"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 1044860339847170
    m_Localized: OUVRIR LE COFFRE
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 1048086925639680
    m_Localized: NIVEAUX
    m_Metadata:
      m_Items:
      - rid: 1668092879795126365
  - m_Id: 1048086925639681
    m_Localized: "Mouvement : Oui"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639682
    m_Localized: "Mouvement : R\u00e9duit"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639683
    m_Localized: "Revoir le tutoriel Patte"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639684
    m_Localized: "La bouteille cible est pleine."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639685
    m_Localized: "Choisis une bouteille vide ou la m\u00eame couleur au sommet."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639686
    m_Localized: "Annuler inverse le dernier versement."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639687
    m_Localized: "L\u2019indice marque la source et la cible."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639688
    m_Localized: "La bouteille bonus ajoute une bouteille vide."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639689
    m_Localized: "M\u00e9langer change l\u2019ordre des bouteilles."
    m_Metadata:
      m_Items: []
