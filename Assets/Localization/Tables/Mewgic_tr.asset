    m_Localized: "Klanlar"
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897869
    m_Localized: "Ge\u00e7mi\u015f"
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897870
    m_Localized: "Yenile"
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897871
    m_Localized: "Arena sunucusuna ba\u011flan\u0131l\u0131yor\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897872
    m_Localized: "Hen\u00fcz tamamlanan sezon yok."
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897873
    m_Localized: "Ar\u015fiv \u00b7 Sezon s\u0131ralamas\u0131 kesinle\u015fti."
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897874
    m_Localized: "S\u00fcre ve lig puan\u0131 sunucudan al\u0131n\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897875
    m_Localized: "Bu \u00f6d\u00fcl ba\u015fka bir oyun kayd\u0131na ba\u011flanm\u0131\u015f."
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897876
    m_Localized: "Lig bilgisi al\u0131namad\u0131. Yenilemeyi dene."
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897877
    m_Localized: "Sezon {0} \u00b7 {1}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 2924300237897878
    m_Localized: "Klan\u0131n\u0131n s\u0131ras\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897879
    m_Localized: "Kendi s\u0131ran"
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897880
    m_Localized: "Sezon kazan\u0131\u015f hedefi \u00b7 {0}/{1}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 2924300237897881
    m_Localized: "Bu sezonda hen\u00fcz do\u011frulanm\u0131\u015f lig katk\u0131s\u0131 yok."
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897882
    m_Localized: "Yak\u0131n s\u0131ralar"
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897883
    m_Localized: "Liderlik tablosu"
    m_Metadata:
      m_Items: []
  - m_Id: 2924300237897884
    m_Localized: "Hen\u00fcz s\u0131ralamaya giren yok."
    m_Metadata:
      m_Items: []
