    m_Localized: Bakiye {0} coin
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1443505006542853
    m_Localized: Yeterli coin yok.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1443505006542854
    m_Localized: "Sat\u0131n al\u0131nd\u0131. Stok {0}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1443505006542855
    m_Localized: "Sonraki sand\u0131\u011Fa {0} dk"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1445448714125312
    m_Localized: "M\xFCzik"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1445448823177216
    m_Localized: Ses efektleri
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1445448823177217
    m_Localized: "Titre\u015Fim"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1445448823177218
    m_Localized: Hareketi azalt
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1445448823177219
    m_Localized: "A\xE7\u0131k"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1445448823177220
    m_Localized: "Kapal\u0131"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1445448823177221
    m_Localized: "{0} \xB7 {1}"
    m_Metadata:
