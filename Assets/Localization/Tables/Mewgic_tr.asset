  - m_Id: 1044860339847170
    m_Localized: "SANDI\u011EI A\xC7"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1048086925639680
    m_Localized: "B\xD6L\xDCMLER"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1048086925639681
    m_Localized: "Hareket: A\u00e7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639682
    m_Localized: "Hareket: Az"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639683
    m_Localized: "Pati Rehberini Tekrar Oynat"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639684
    m_Localized: "Hedef \u015fi\u015fe dolu."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639685
    m_Localized: "Bo\u015f veya \u00fcst\u00fc ayn\u0131 renk olan \u015fi\u015feyi se\u00e7."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639686
    m_Localized: "Geri Al son d\u00f6k\u00fc\u015f\u00fc geri \u00e7evirir."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639687
    m_Localized: "\u0130pucu kaynak ve hedefi i\u015faretler."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639688
    m_Localized: "Ek \u015ei\u015fe bo\u015f bir \u015fi\u015fe ekler."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639689
    m_Localized: "Kar\u0131\u015ft\u0131r \u015fi\u015felerin yerini de\u011fi\u015ftirir."
    m_Metadata:
      m_Items: []
  - m_Id: 1443504847159296
    m_Localized: "B\xF6l\xFCm +{0}  \xB7  Y\u0131ld\u0131z +{1}\n\u0130lk deneme
      +{2}  \xB7  \u0130pucusuz +{3}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1443505006542848
    m_Localized: Animasyonu atla
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1443505006542849
    m_Localized: Kaydetmeyi tekrar dene
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1443505006542850
    m_Localized: "Yard\u0131mc\u0131 g\xFC\xE7ler"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1443505006542851
    m_Localized: "{0} \xD71 \xB7 {1} coin"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
