  - m_Id: 2225802149888
    m_Localized: "G\xDCNL\xDCK G\xD6REVLER\u0130 A\xC7"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 2973327785984
    m_Localized: "G\xFCnl\xFCk Hediye"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 1044860214018048
    m_Localized: +{0} coin
    m_Metadata:
      m_Items:
