      m_Items:
      - rid: 1668092879795126368
  - m_Id: 3190128678
    m_Localized: "{0}\nYeni ada a\xE7\u0131ld\u0131!"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126368
  - m_Id: 3190128679
    m_Localized: "{0}\nB\xF6l\xFCmler {1}\u2013{2}"
