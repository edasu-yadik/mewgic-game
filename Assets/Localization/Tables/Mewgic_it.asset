  - m_Id: 3185934373
    m_Localized: Missioni giornaliere
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934374
    m_Localized: Completa {0:plural:{} bottiglia|{} bottiglie} nei livelli vinti
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934375
    m_Localized: Vinci {0:plural:{} livello|{} livelli}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934376
    m_Localized: Ottieni {0:plural:{} stella|{} stelle} nei livelli vinti
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934377
    m_Localized: Usa {0:plural:{} potenziamento|{} potenziamenti}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934378
    m_Localized: Le ricompense danno usi reali dei potenziamenti.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934379
    m_Localized: RISCATTA REGALO
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934380
    m_Localized: +{0} suggerimento
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934381
    m_Localized: Suggerimento salvato. Torna domani!
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934382
    m_Localized: Impossibile riscattare il regalo. Controlla la data e il salvataggio.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934383
    m_Localized: Ricompensa della missione salvata!
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934384
    m_Localized: "Il regalo del giorno \xE8 pronto!"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934385
    m_Localized: "Regalo di oggi gi\xE0 riscattato."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934386
    m_Localized: Attendi un nuovo giorno locale e almeno 20 ore.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3185934387
    m_Localized: "Si rinnova a mezzanotte locale \u2022 {0:d}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128640
    m_Localized: Collezione
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128641
    m_Localized: EVENTI E RICOMPENSE
    m_Metadata:
      m_Items:
