  - m_Id: 3190128681
    m_Localized: TORNA ALLA MAPPA
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128682
    m_Localized: "Il livello {0} \xE8 bloccato. Completa prima il precedente."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128683
    m_Localized: "La ricompensa di questo forziere \xE8 gi\xE0 stata riscattata."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128684
    m_Localized: "{0}\nCompleta i 50 livelli dell\u2019isola per aprire il forziere."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128685
    m_Localized: "Il forziere \xE8 pronto!\nPremio: +{0} suggerimento"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128686
    m_Localized: Forziere aperto! Suggerimento salvato.
