    m_Localized: 'Evento settimanale

      Settimana delle Cascate di Cristallo'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128647
    m_Localized: 'Vinci {0} livelli

      +1 mescola + distintivo stella'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128648
    m_Localized: RISCATTA FORZIERE
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128649
    m_Localized: Ricompensa salvata!
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128650
    m_Localized: "La ricompensa non \xE8 pronta o \xE8 gi\xE0 stata riscattata."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128651
    m_Localized: "Pass stagionale \u2022 Percorso gratuito"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128652
    m_Localized: +1 annulla
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128653
    m_Localized: '+1 bottiglia extra

      + carta del gatto'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128654
    m_Localized: "Premium \u2022 In arrivo"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128655
    m_Localized: "Contenuti premium e acquisti non disponibili. Nessun pagamento;
      \xE8 attivo solo il percorso gratuito."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128656
    m_Localized: Distintivo stella
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128657
    m_Localized: Carta del gatto mago
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128658
    m_Localized: "La tua carta da collezione. Visibile nella galleria; non \xE8 equipaggiamento."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128659
    m_Localized: Vinci 3 livelli in una settimana e riscatta il forziere settimanale.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128660
    m_Localized: Riscatta il premio finale del percorso stagionale gratuito.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128661
    m_Localized: Le carte ottenute restano nella tua collezione.
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128662
    m_Localized: "Eventi offline \u2022 Vinci livelli per avanzare."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128663
    m_Localized: 'Completa le missioni di oggi.

      Premi disponibili: {0}'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126369
  - m_Id: 3190128664
    m_Localized: "OFFLINE \u2022 {0:dd MMM} \u2013 {1:dd MMM}"
