      - rid: 1668092879795126372
  - m_Id: 1662528094210
    m_Localized: '{0:0.#}Q'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 2225802149888
    m_Localized: "ABRIR MISS\xD5ES DI\xC1RIAS"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 2973327785984
    m_Localized: Presente
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1044860214018048
    m_Localized: +{0} moedas
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1044860339847168
    m_Localized: "+{0} moedas\nConclus\xE3o {1} + Estrelas {2}\nDicas +{3}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1044860339847169
    m_Localized: '{0} moedas + {1} dica'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1044860339847170
    m_Localized: "ABRIR BA\xDA"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1048086925639680
    m_Localized: FASES
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1048086925639681
    m_Localized: "Movimento: Sim"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639682
    m_Localized: "Movimento: Reduzido"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639683
    m_Localized: "Rever o tutorial da patinha"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639684
    m_Localized: "O frasco de destino est\u00e1 cheio."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639685
    m_Localized: "Escolha um frasco vazio ou com a mesma cor no topo."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639686
    m_Localized: "Desfazer reverte o \u00faltimo despejo."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639687
    m_Localized: "A dica indica a origem e o destino."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639688
    m_Localized: "Frasco extra adiciona um frasco vazio."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639689
    m_Localized: "Embaralhar muda a ordem dos frascos."
    m_Metadata:
      m_Items: []
  - m_Id: 1443504847159296
    m_Localized: "N\xEDvel +{0}  \xB7  Estrelas +{1}\nPrimeira tentativa +{2}  \xB7  Sem dica +{3}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1443505006542848
    m_Localized: "Pular anima\xE7\xE3o"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1443505006542849
    m_Localized: Tentar salvar novamente
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1443505006542850
    m_Localized: "Refor\xE7os"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1443505006542851
    m_Localized: "{0} \xD71 \xB7 {1} moedas"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1443505006542852
    m_Localized: Saldo {0} moedas
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1443505006542853
    m_Localized: "Voc\xEA precisa de mais moedas."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1443505006542854
    m_Localized: Comprado. Em estoque {0}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1443505006542855
    m_Localized: "Pr\xF3ximo ba\xFA em {0} min"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1445448714125312
    m_Localized: "M\xFAsica"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1445448823177216
    m_Localized: Efeitos sonoros
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1445448823177217
    m_Localized: "Vibra\xE7\xE3o"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1445448823177218
    m_Localized: Reduzir o movimento
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1445448823177219
    m_Localized: Ativado
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1445448823177220
    m_Localized: Desativado
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1445448823177221
    m_Localized: "{0} \xB7 {1}"
    m_Metadata:
      m_Items:
