    m_Localized: "{0} \u2022 Al\xE9m da n\xE9voa"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128678
    m_Localized: '{0}

      Nova ilha desbloqueada!'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128679
    m_Localized: "{0}\nFases {1}\u2013{2}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128680
    m_Localized: "Escolha uma fase \u2022 Melhore suas estrelas"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128681
    m_Localized: VOLTAR AO MAPA
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128682
    m_Localized: "A fase {0} est\xE1 bloqueada. Conclua a anterior primeiro."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128683
    m_Localized: "A recompensa deste ba\xFA j\xE1 foi resgatada."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128684
    m_Localized: "{0}\nConclua as 50 fases da ilha para abrir o ba\xFA."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128685
    m_Localized: "Seu ba\xFA est\xE1 pronto!\nPr\xEAmio: +{0} dica"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128686
    m_Localized: "Ba\xFA aberto! Dica salva."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128687
    m_Localized: "Preparando fase\u2026"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128688
    m_Localized: Novos Horizontes {0}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128689
    m_Localized: Vila Encantada
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128690
    m_Localized: Cataratas de Cristal
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128691
    m_Localized: Jardim Lunar
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128692
    m_Localized: Castelo Celeste
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128693
    m_Localized: Bosque dos Sussurros
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128694
    m_Localized: Miragem Dourada
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128695
    m_Localized: Reino dos Corais
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128696
    m_Localized: Picos de Gelo Luminoso
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128697
    m_Localized: "Ilhas Mec\xE2nicas"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128698
    m_Localized: Bosque Estelar
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128699
    m_Localized: Biblioteca Arcana
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128700
    m_Localized: Cidadela da Aurora
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 1662448402432
    m_Localized: '{0:0.#} mi'
    m_Metadata:
