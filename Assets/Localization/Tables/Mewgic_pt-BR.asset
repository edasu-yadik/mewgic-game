      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128644
    m_Localized: "Miss\xF5es\ndi\xE1rias"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128645
    m_Localized: "Pr\xEAmios de\ncole\xE7\xE3o"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128646
    m_Localized: 'Evento semanal

      Semana das Cataratas de Cristal'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128647
    m_Localized: "Ven\xE7a {0} fases\n+1 mistura + distintivo estelar"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128648
    m_Localized: "RESGATAR BA\xDA"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128649
    m_Localized: Recompensa salva!
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128650
    m_Localized: "A recompensa ainda n\xE3o est\xE1 pronta ou j\xE1 foi resgatada."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128651
    m_Localized: "Passe de temporada \u2022 Caminho gr\xE1tis"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128652
    m_Localized: +1 desfazer
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128653
    m_Localized: '+1 garrafa extra

      + carta do gato'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128654
    m_Localized: "Premium \u2022 Em breve"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128655
    m_Localized: "O conte\xFAdo premium e as compras n\xE3o est\xE3o dispon\xEDveis.
      Nada \xE9 cobrado; apenas o caminho gr\xE1tis est\xE1 ativo."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128656
    m_Localized: Distintivo estelar
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128657
    m_Localized: Carta do gato mago
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128658
    m_Localized: "Sua carta colecion\xE1vel. Aparece na galeria; n\xE3o \xE9 equipamento."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128659
    m_Localized: "Ven\xE7a 3 fases em uma semana e resgate o ba\xFA semanal."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128660
    m_Localized: "Resgate a recompensa final do caminho gr\xE1tis da temporada."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128661
    m_Localized: "As cartas ganhas ficam na sua cole\xE7\xE3o."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128662
    m_Localized: "Eventos offline \u2022 Ven\xE7a fases para avan\xE7ar."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128663
    m_Localized: "Complete as miss\xF5es de hoje.\nPr\xEAmios dispon\xEDveis: {0}"
