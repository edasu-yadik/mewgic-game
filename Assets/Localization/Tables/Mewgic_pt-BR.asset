    m_Localized: EVENTOS E RECOMPENSAS
    m_Metadata:
      m_Items:
      - rid: 1668092879795126372
  - m_Id: 3190128642
    m_Localized: 'Evento

      semanal'
    m_Metadata:
      m_Items:
