  - m_Id: 1662528094210
    m_Localized: '{0:0.#}Q'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 2225802149888
    m_Localized: "OTW\xD3RZ CODZIENNE ZADANIA"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 2973327785984
    m_Localized: Prezent
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1044860214018048
    m_Localized: +{0} monet
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1044860339847168
    m_Localized: "+{0} monet\nUko\u0144czenie {1} + Gwiazdy {2}\nPodpowiedzi +{3}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1044860339847169
    m_Localized: "{0} monet + {1} podpowied\u017A"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1044860339847170
    m_Localized: "OTW\xD3RZ SKRZYNI\u0118"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1048086925639680
    m_Localized: POZIOMY
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1048086925639681
    m_Localized: "Ruch: Pe\u0142ny"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639682
    m_Localized: "Ruch: Ograniczony"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639683
    m_Localized: "Powt\u00f3rz samouczek \u0142apki"
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639684
    m_Localized: "Butelka docelowa jest pe\u0142na."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639685
    m_Localized: "Wybierz pust\u0105 butelk\u0119 lub ten sam kolor na g\u00f3rze."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639686
    m_Localized: "Cofnij odwraca ostatnie przelanie."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639687
    m_Localized: "Wskaz\u00f3wka oznacza \u017ar\u00f3d\u0142o i cel."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639688
    m_Localized: "Dodatkowa butelka dodaje pust\u0105 butelk\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 1048086925639689
    m_Localized: "Tasuj zmienia kolejno\u015b\u0107 butelek."
    m_Metadata:
      m_Items: []
  - m_Id: 1443504847159296
    m_Localized: "Poziom +{0}  \xB7  Gwiazdy +{1}\nPierwsza pr\xF3ba +{2}  \xB7  Bez wskaz\xF3wki +{3}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1443505006542848
    m_Localized: "Pomi\u0144 animacj\u0119"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1443505006542849
    m_Localized: "Pon\xF3w zapis"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1443505006542850
    m_Localized: Dopalacze
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1443505006542851
    m_Localized: "{0} \xD71 \xB7 {1} monet"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1443505006542852
    m_Localized: Saldo {0} monet
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1443505006542853
    m_Localized: "Potrzebujesz wi\u0119cej monet."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1443505006542854
    m_Localized: Kupiono. Zapas {0}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1443505006542855
    m_Localized: "Nast\u0119pna skrzynia za {0} min"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
