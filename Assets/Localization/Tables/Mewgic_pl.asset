      - rid: 1668092879795126370
  - m_Id: 3190128667
    m_Localized: "MEWGIC \u2022 MAPA \u015AWIATA"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128668
    m_Localized: "\u2039 POPRZEDNIA WYSPA"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128669
    m_Localized: "NAST\u0118PNA WYSPA \u203A"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128670
    m_Localized: "M\xD3J POZIOM"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128671
    m_Localized: "Przewi\u0144 \u2022 Wybierz wysp\u0119"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128672
    m_Localized: "50 nowych przyg\xF3d na ka\u017Cdej wyspie"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128673
    m_Localized: "{0} \u2022 {1}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128674
    m_Localized: "{0} \u2022 ZABLOKOWANA"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128675
    m_Localized: "Poziomy {0}\u2013{1}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128676
    m_Localized: "ZABLOKOWANE \u2022 {0}\u2013{1}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128677
    m_Localized: "{0} \u2022 Za mg\u0142\u0105"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128678
    m_Localized: '{0}

      Nowa wyspa odblokowana!'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128679
    m_Localized: "{0}\nPoziomy {1}\u2013{2}"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128680
    m_Localized: "Wybierz poziom \u2022 Zdob\u0105d\u017A wi\u0119cej gwiazdek"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128681
    m_Localized: "WR\xD3\u0106 DO MAPY"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128682
    m_Localized: "Poziom {0} jest zablokowany. Najpierw uko\u0144cz poprzedni."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128683
    m_Localized: "Nagroda z tej skrzyni zosta\u0142a ju\u017C odebrana."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128684
    m_Localized: "{0}\nUko\u0144cz 50 poziom\xF3w wyspy, by otworzy\u0107 skrzyni\u0119."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128685
    m_Localized: "Skrzynia jest gotowa!\nNagroda: +{0} podpowied\u017A"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128686
    m_Localized: "Skrzynia otwarta! Podpowied\u017A zapisana."
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128687
    m_Localized: "Przygotowujemy poziom\u2026"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128688
    m_Localized: Nowe Horyzonty {0}
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128689
    m_Localized: Zaczarowana Wioska
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128690
    m_Localized: "Kryszta\u0142owe Wodospady"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128691
    m_Localized: "Ksi\u0119\u017Cycowy Ogr\xF3d"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128692
    m_Localized: Podniebny Zamek
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128693
    m_Localized: "Szepcz\u0105cy Las"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128694
    m_Localized: "Z\u0142oty Mira\u017C"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128695
    m_Localized: "Koralowe Kr\xF3lestwo"
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128696
    m_Localized: Szczyty Lodowego Blasku
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128697
    m_Localized: Mechaniczne Wyspy
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128698
    m_Localized: Gwiezdny Gaj
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128699
    m_Localized: Biblioteka Magii
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 3190128700
    m_Localized: Cytadela Zorzy
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1662448402432
    m_Localized: '{0:0.#} mln'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1662528094208
    m_Localized: '{0:0.#} mld'
    m_Metadata:
      m_Items:
      - rid: 1668092879795126370
  - m_Id: 1662528094209
    m_Localized: '{0:0.#}T'
    m_Metadata:
